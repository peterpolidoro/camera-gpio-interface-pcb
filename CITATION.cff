    given-names: Peter
    email: polidorop@janelia.hhmi.org
    affiliation: "Janelia Research Campus, Howard Hughes Medical Institute"
repository-code: "https://github.com/peterpolidoro/camera-gpio-interface-pcb"
version: "1.0"
license:
