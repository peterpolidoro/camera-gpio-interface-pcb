	(text "Blackfly S GPIO channel | trigger in, sync in, exposure out, five taps; vertical or horizontal header" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "fb12b5a9-a2a1-5ae0-8620-c97246e15c0f"))
	(text "One FLIR Blackfly S camera GPIO channel (trigger, sync, exposure output, instrument taps) on a 6-position 3.5 mm Phoenix header; the connector family pilot: the vertical MCV and the horizontal MC header are pad-identical, so one source publishes both orientations" (at 15.24 21.082 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "9202f696-7433-52d4-b3bd-d44631e15ee5"))
	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 26.322 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b5ace96d-a45c-5b83-8242-7502c20bc31d"))
	(polyline (pts (xy 15.24 36.482) (xy 211.88 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "3aa1a343-951a-56fd-81c6-e48c15f22a37"))
	(text "1. Camera header" (at 15.24 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "dfe53e51-bacc-5e3e-9b58-d81e7591539b"))
	(text "${9870f529-44e6-4b20-b7b7-ad6eefe47ea1:REFERENCE}, the 6-position 3.5 mm Phoenix header; pins 1 to 4 are Lines 3, 0, 2 and 1, pins 5 and 6 are the camera's two grounds." (at 15.24 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "564348c4-b1d8-54b6-8f90-d2f572a5dcf2"))
	(text "Camera GPIO header, 6-pos" (at 20.32 83.566 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fff476c9-2d6a-51b6-b090-72fd30fc6a5a"))
	(text "3.5 mm" (at 20.32 86.106 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "78580a8c-f2a2-585f-8422-dca6ddbc6fd7"))
	(text "PLACE: Place ${9870f529-44e6-4b20-b7b7-ad6eefe47ea1:REFERENCE} at the board edge the plug needs: the vertical body takes the plug from above, the horizontal from its +Y side; the anchor is the pad-array centre for both." (at 15.24 91.186 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5e43c73c-ae22-58b9-9457-b7790836a429"))
	(text "ROUTE: L3, L0, L2 and L1 run straight from the pads to their clamps and parts; GND from pins 5 and 6 into the block's return." (at 15.24 94.996 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c820cd32-3d24-5216-b6ad-5a33d74664eb"))
	(polyline (pts (xy 219.5 36.482) (xy 399.5 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "3cd95e58-ccb9-5f01-8991-274410f249c7"))
	(text "2. Line 3 trigger drive" (at 219.5 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "67174999-9990-5d60-9393-08bdeb1ea0fe"))
	(text "${f2a309ed-c3a7-4688-9fba-6e6298bb60c4:REFERENCE} (always enabled) drives L3_DRV; ${e2b2fc18-b9db-4fd9-b2bd-7091a09daaf9:REFERENCE} (220 ohm) in series feeds camera Line 3 on L3; ${10c6213d-5751-476b-ac77-4f982af27ee4:REFERENCE} bypasses ${f2a309ed-c3a7-4688-9fba-6e6298bb60c4:REFERENCE}'s VCC." (at 219.5 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9f76da85-6d6f-536a-b936-3563177b9f65"))
	(text "VCC pin 6 bypass, ${f2a309ed-c3a7-4688-9fba-6e6298bb60c4:REFERENCE}" (at 224.58 84.504592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a400bf8a-7ba1-5b05-8728-ccba24a337e7"))
	(text "Line 3 trigger driver, always enabled" (at 224.58 145.464592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "28fbb885-5ac1-5055-b3d2-cb1b289f9a60"))
	(text "L3 trigger series, 220 ohm" (at 283.04053 129.286 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b6a4c70d-4ca5-5ef6-8892-becf6936af00"))
	(text "PLACE: Place ${f2a309ed-c3a7-4688-9fba-6e6298bb60c4:REFERENCE} near ${9870f529-44e6-4b20-b7b7-ad6eefe47ea1:REFERENCE} pin 1 with ${10c6213d-5751-476b-ac77-4f982af27ee4:REFERENCE} at its pin 6 and a short return to pin 3; ${e2b2fc18-b9db-4fd9-b2bd-7091a09daaf9:REFERENCE} between the driver and the connector." (at 219.5 150.544592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "af699bf3-1239-5c5c-8333-ff87c621f043"))
	(text "ROUTE: L3 is a 3.3 V edge-triggered line: short, over ground, away from the switching parts of the board." (at 219.5 154.354592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "20821269-0116-5658-a1d8-cc49faa81467"))
	(polyline (pts (xy 15.24 106.426) (xy 195.24 106.426)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "4023b153-7cae-5997-8604-13df77aacb86"))
	(text "3. Line 0 sync drive" (at 15.24 108.966 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "325d4585-8a41-5cf0-9afe-dae1d2aea618"))
	(text "${dd33be72-e19b-47bb-8c97-5f79fc6338dd:REFERENCE}'s open-drain Y pulls L0 low; ${178e863a-fc0b-474a-a537-37a978202ec6:REFERENCE} (820 ohm) returns it to +5V, the opto input's drive level; ${51f86269-ea15-4394-96b4-401365e1f3d8:REFERENCE} bypasses ${dd33be72-e19b-47bb-8c97-5f79fc6338dd:REFERENCE}'s VCC." (at 15.24 113.116 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "81cb1fd4-245e-5412-bb40-a43a574d343a"))
	(text "VCC pin 6 bypass, ${dd33be72-e19b-47bb-8c97-5f79fc6338dd:REFERENCE}" (at 20.32 155.624592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fa634238-e7cf-52fb-b254-0060434c21e7"))
	(text "Line 0 sync driver, open drain" (at 20.32 216.584592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5077749e-287c-524c-924b-30173246c16c"))
	(text "L0 opto pull-up to" (at 74.856217 207.282741 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "de4f2d80-1433-530c-8664-d8d529dcfc91"))
	(text "+5V, 820 ohm" (at 74.856217 209.822741 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0d21d66d-b023-556c-8a82-94a01b11fd84"))
	(text "PLACE: Place ${dd33be72-e19b-47bb-8c97-5f79fc6338dd:REFERENCE} near ${9870f529-44e6-4b20-b7b7-ad6eefe47ea1:REFERENCE} pin 2 with ${51f86269-ea15-4394-96b4-401365e1f3d8:REFERENCE} at its pin 6; ${178e863a-fc0b-474a-a537-37a978202ec6:REFERENCE} from L0 to the +5V entry." (at 15.24 221.664592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1ac2f2fb-c6fa-5bd0-8607-7b4477c6686d"))
