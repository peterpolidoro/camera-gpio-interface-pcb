	(text "100 ohm series taps: ${36ae1bf1-62f5-4585-a0a5-cbbeae222810:REFERENCE} on L3, ${642b01e2-3cf0-4087-9e79-7690710e4ee1:REFERENCE} on L0, ${c1c7dcbb-7ba6-4d65-abfe-75ca335b5472:REFERENCE} on L2, ${d801cc5a-56c7-46d3-b83c-08021792d765:REFERENCE} on L1_BUF, ${7ee20496-46fb-424b-933f-80f3d28223df:REFERENCE} on CAM_OUT, each to its _INST port." (at 15.24 342.654592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8f128fad-03d9-539e-a286-fc03fe8b5915"))
