	(text "ROUTE: INSTRUMENT class to the instrument port; every tapped node has a DC definition (driven or pulled up)." (at 15.24 379.476 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f614cf6a-6a75-5495-a3fb-2b64c050ff74"))
	(text "INTERFACES" (at 423.76 36.482 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "023ca25b-9274-52b8-8da9-5250f8bb06c0"))
	(text "Must be a 5 V rail: the Line 0 opto drive level (${178e863a-fc0b-474a-a537-37a978202ec6:REFERENCE}) and both ESD clamps' VBUS reference." (at 423.76 46.99 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "72bc8e09-8132-5e1a-ab03-cc2dc365d67a"))
	(text "Logic rail for ${e310c8b3-8386-4c71-bde8-59dd025d7495:REFERENCE}, ${f2a309ed-c3a7-4688-9fba-6e6298bb60c4:REFERENCE}, ${dd33be72-e19b-47bb-8c97-5f79fc6338dd:REFERENCE} and the L2/L1 pull-ups; always-on if the taps must read before firmware." (at 423.76 59.69 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "32a4490c-2cba-5dcb-beeb-d2a34aaed97a"))
	(text "Camera pins 5 (opto ground) and 6 (ground) both land here, with the logic and ESD returns." (at 423.76 72.39 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "64237033-c5c7-526d-99f2-a9c77268d1c7"))
	(text "Conditioned 3.3 V frame trigger from the board's input Schmitt into ${f2a309ed-c3a7-4688-9fba-6e6298bb60c4:REFERENCE} (pin 2)." (at 423.76 85.09 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9fe6d829-432b-596c-a0e8-c8844a0c006d"))
	(text "Conditioned 3.3 V Rsync from the board's input Schmitt into ${dd33be72-e19b-47bb-8c97-5f79fc6338dd:REFERENCE} (pin 2)." (at 423.76 97.79 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2060888a-fec7-5cad-98da-24c01a67fa3c"))
	(text "Exposure-active output: CAM_OUT through ${bb6ecb9c-0931-426d-845e-0c0aab3a6240:REFERENCE} (470 ohm); the BNC itself is the board's." (at 423.76 110.49 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "adca7f77-e011-5e09-90be-81f66eafd040"))
	(text "100 ohm tap (${642b01e2-3cf0-4087-9e79-7690710e4ee1:REFERENCE}) on L0, camera Line 0 OPTOIN: the sync drive." (at 423.76 123.19 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "53a707f1-c4bc-57b8-b9af-56a6b26db7d8"))
	(text "100 ohm tap (${d801cc5a-56c7-46d3-b83c-08021792d765:REFERENCE}) on L1_BUF, camera Line 1 OPTOOUT after the Schmitt buffer." (at 423.76 135.89 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5999c92a-964d-5719-9899-954379f592df"))
	(text "100 ohm tap (${c1c7dcbb-7ba6-4d65-abfe-75ca335b5472:REFERENCE}) on L2, camera Line 2, the open-drain exposure output." (at 423.76 146.05 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2d1bb184-cbd0-5b00-b0b7-26cf71072158"))
	(text "100 ohm tap (${36ae1bf1-62f5-4585-a0a5-cbbeae222810:REFERENCE}) on L3, camera Line 3, the frame trigger." (at 423.76 156.21 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2d8bef2a-12cf-5833-bdaf-ed3df2888b94"))
	(text "100 ohm tap (${7ee20496-46fb-424b-933f-80f3d28223df:REFERENCE}) on CAM_OUT, the buffered exposure signal." (at 423.76 166.37 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "996f3a3f-e17c-5eb3-bc11-280660e9cc28"))
	(polyline (pts (xy 423.76 181.61) (xy 578.76 181.61)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "1dc4195c-34fd-56af-83fd-6089dd602b1c"))
	(text "INTERNAL NETS" (at 423.76 184.15 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "c217e778-6b51-5c9e-96c5-4861d98a23ba"))
	(text "CAM_OUT: Buffered Line 2 (exposure active) from ${e310c8b3-8386-4c71-bde8-59dd025d7495:REFERENCE} 1Y; drives the BNC resistor, the LED resistor and the OUT tap." (at 423.76 188.3 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "db49b538-480e-557d-9765-e78d28c19f8a"))
	(text "L0: Camera pin 2, Line 0 OPTOIN: open-drain ${dd33be72-e19b-47bb-8c97-5f79fc6338dd:REFERENCE} Y, pulled to +5V by ${178e863a-fc0b-474a-a537-37a978202ec6:REFERENCE} (820 ohm), clamped by ${48a9c958-f5c0-40e3-808a-a90231a7600d:REFERENCE}." (at 423.76 192.11 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3c485f84-e8a1-5b1f-888f-0ff7fcc12c48"))
	(text "L1: Camera pin 4, Line 1 OPTOOUT, pulled up to +3.3V by ${0eab7050-ae9a-4b12-9155-20dceb5716cb:REFERENCE} (4.7 k), into Schmitt 2A, clamped by ${7159ba13-fb07-4faf-92f2-3f1d229d5679:REFERENCE}." (at 423.76 195.92 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ea397202-13b7-5b6b-bafc-cc8adbbb20b4"))
	(text "L1_BUF: Schmitt 2Y: buffered Line 1 for the L1_INST tap." (at 423.76 199.73 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6624bfdf-6eeb-5c12-9793-5bf6264342b6"))
	(text "L2: Camera pin 3, Line 2 as open-drain exposure output, pulled up by ${2227e749-0a2c-4f93-a597-7a23f0e525e1:REFERENCE} (1 k), into Schmitt 1A, clamped by ${7159ba13-fb07-4faf-92f2-3f1d229d5679:REFERENCE}." (at 423.76 203.54 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2c2d8007-4c78-5437-b382-3c91e17b9504"))
	(text "L3: Camera pin 1, Line 3 GPI trigger, driven by ${f2a309ed-c3a7-4688-9fba-6e6298bb60c4:REFERENCE} through ${e2b2fc18-b9db-4fd9-b2bd-7091a09daaf9:REFERENCE} (220 ohm), clamped by ${48a9c958-f5c0-40e3-808a-a90231a7600d:REFERENCE}." (at 423.76 207.35 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "94092544-19e7-5a8e-b496-ba619db02c15"))
	(text "L3_DRV: ${f2a309ed-c3a7-4688-9fba-6e6298bb60c4:REFERENCE} Y, the trigger drive before the 220 ohm series resistor." (at 423.76 211.16 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6a62cb29-f33d-598f-abd1-9068deba2cfe"))
	(text "LED_A: LED anode: ${7171eb4e-e966-4be1-9b44-87954c581611:REFERENCE} (680 ohm) from CAM_OUT, so ${be5d977c-6c2a-4581-bd66-db9ce884480f:REFERENCE} lights while exposure is active." (at 423.76 214.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "067a6b3b-f2ea-5fa1-9cc6-f5512d7eaf5c"))
	(polyline (pts (xy 423.76 226.4) (xy 578.76 226.4)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "88f21479-eea9-5e64-a303-10e92ea7ae8c"))
	(text "OPERATION" (at 423.76 228.94 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "2d59cdab-ed51-58ca-a7d5-ffee48f8b4e1"))
	(text "Camera side: ${9870f529-44e6-4b20-b7b7-ad6eefe47ea1:REFERENCE}'s terminal numbers are the camera's Hirose HR10A-7R-6PB pin numbers, wired with the FLIR 1 m flying-lead GPIO cable into" (at 423.76 233.09 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7d243382-86a3-5e8c-b933-e3bc3f2dfbdd"))
	(text "a Phoenix MC 1,5/6-ST-3,5 plug: pin 1 green Line 3 (GPI, trigger), pin 2 black Line 0 (OPTOIN, sync), pin 3 red Line 2 (GPIO, exposure output), pin" (at 423.76 235.63 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bdee7cba-496a-5714-a06f-b3d03d2a6550"))
	(text "4 white Line 1 (OPTOOUT), pin 5 blue opto ground and pin 6 brown ground, both on GND (common-ground wiring)." (at 423.76 238.17 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c6fc1cbf-5d5a-5961-b051-51f47bde1a9f"))
	(text "Trigger path: TRIG_IN -> ${f2a309ed-c3a7-4688-9fba-6e6298bb60c4:REFERENCE} (SN74LVC1G125, ~{OE} pin 1 grounded, so always enabled) -> L3_DRV -> ${e2b2fc18-b9db-4fd9-b2bd-7091a09daaf9:REFERENCE} (220 ohm) -> L3 -> camera" (at 423.76 242.88 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b5744bf1-3267-5cd2-9850-8bfa2b05487d"))
	(text "Line 3; camera settings TriggerSelector FrameStart, TriggerSource Line3 RisingEdge. Sync path: SYNC_IN -> ${dd33be72-e19b-47bb-8c97-5f79fc6338dd:REFERENCE} (SN74LVC1G07 open drain) ->" (at 423.76 245.42 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "870bb97d-cac3-51e2-bb63-8e2175ddd4da"))
	(text "L0, pulled to +5V by ${178e863a-fc0b-474a-a537-37a978202ec6:REFERENCE} (820 ohm): 5 V across 820 ohm is about 6 mA, less by the opto input's forward drop. Both drivers run from +3.3V with" (at 423.76 247.96 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e59e3980-a49c-5151-9ca1-d8b2d1d80865"))
	(text "5.5 V-tolerant I/O." (at 423.76 250.5 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d7ce728b-ebe9-542d-a5ae-f15944414fdc"))
	(text "Exposure output: camera Line 2 (LineMode Output, LineSource ExposureActive, V3_3Enable false, so open drain) is pulled up by ${2227e749-0a2c-4f93-a597-7a23f0e525e1:REFERENCE} (1 k) to" (at 423.76 254.31 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b9cd86cd-b97c-5807-8d0d-5d36e44683e7"))
	(text "+3.3V and squared by Schmitt ${e310c8b3-8386-4c71-bde8-59dd025d7495:REFERENCE} 1A -> 1Y = CAM_OUT, which drives the BNC through ${bb6ecb9c-0931-426d-845e-0c0aab3a6240:REFERENCE} (470 ohm), the green LED ${be5d977c-6c2a-4581-bd66-db9ce884480f:REFERENCE} through" (at 423.76 256.85 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ccfb2710-cbe8-53aa-a315-97270e932d30"))
	(text "${7171eb4e-e966-4be1-9b44-87954c581611:REFERENCE} (680 ohm: about (3.3 - 2.1) / 680 = 1.8 mA, LED on while exposure is active) and the OUT_INST tap. Line 1 (OPTOOUT, LineSource Off) is" (at 423.76 259.39 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9bb1ee9c-0899-58a9-8060-abeaecf4e095"))
	(text "pulled up by ${0eab7050-ae9a-4b12-9155-20dceb5716cb:REFERENCE} (4.7 k) and buffered 2A -> 2Y into L1_BUF for its tap." (at 423.76 261.93 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "811b729a-28db-569a-939b-b25e8e457a03"))
	(text "ESD: two USBLC6-2P6 arrays with VBUS on +5V clamp L3 and L0 (${48a9c958-f5c0-40e3-808a-a90231a7600d:REFERENCE}) and L2 and L1 (${7159ba13-fb07-4faf-92f2-3f1d229d5679:REFERENCE}), 15 kV IEC 61000-4-2 level 4, at most 3.5" (at 423.76 265.74 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5be225d7-b73c-5814-9071-86922fdfdbbd"))
	(text "pF per line; both I/O pins of each pair are wired to the node, so the footprint's paired pads need no track between them. +5V must therefore be a 5" (at 423.76 268.28 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8a04eeb6-85e6-5781-ab85-9a8f2bbac36d"))
	(text "V rail: it is the clamp reference and the opto drive level, and feeds nothing else." (at 423.76 270.82 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ffb24d27-defb-5b81-aa2f-193976c48604"))
	(text "Variants (family.json): mcv6_vertical fits ${9870f529-44e6-4b20-b7b7-ad6eefe47ea1:REFERENCE} = OW-CONN-TBH-1X06-3P5-VERT (Phoenix MCV 1,5/6-G-3,5, top entry); mc6_horizontal fits" (at 423.76 274.63 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c32949f2-e9d2-5aab-83fd-c7300a00a9f1"))
	(text "OW-CONN-1844252 (Phoenix MC 1,5/6-G-3,5, side entry toward the footprint's +Y). The two footprints are pad-identical (six 1.8 x 3.6 mm ovals on" (at 423.76 277.17 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cad94525-4d0c-5a28-95d3-f25ef7b88721"))
	(text "3.5 mm, origin at the pad-array centre), so the variant swaps only the connector's body, courtyard and 3D model; every pad, track and via stays, and" (at 423.76 279.71 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c1bc5c84-7598-5e69-865d-46dc729eaf3c"))
	(text "the anchor connector_center is the same point for both." (at 423.76 282.25 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3def8ae8-711f-5cf1-a976-1a3916bf530d"))
	(text "The placing board provides +3.3V (bind it to the always-on rail when the taps must be observable before firmware runs), a 5 V rail on +5V, the BNC" (at 423.76 286.06 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "16bf3b20-1056-5d73-9611-e79e0d7cee00"))
	(text "on CAM_OUT_BNC, the conditioned 3.3 V TRIG_IN and SYNC_IN, and the instrument port behind the five 100 ohm taps; the three pull-ups are inside" (at 423.76 288.6 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f046ac2d-8548-5b97-a58f-f473fba7c7b0"))
	(text "because the block owns L0, L1 and L2 (layout convention 10). Place one block per camera; the horizontal variant's plug needs the board edge its wire" (at 423.76 291.14 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ef372d34-81c7-58d8-893b-134ad3517b48"))
	(text "exit faces." (at 423.76 293.68 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4f020909-a180-5662-8bbb-88cd79bf56d8"))
	(polyline (pts (xy 423.76 305.11) (xy 578.76 305.11)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "dd522bc1-d099-5214-94a2-3d9e8213d5cd"))
	(text "DESIGN CONTRACT" (at 423.76 307.65 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "317db91b-795a-5e08-a6b7-c13285527a3b"))
	(text "One FLIR Blackfly S camera GPIO channel (trigger, sync, exposure output, instrument taps) on a 6-position 3.5 mm Phoenix header; the connector" (at 423.76 311.8 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bbe17897-4fe0-57e7-adb5-b6bc5a294c0b"))
	(text "family pilot: the vertical MCV and the horizontal MC header are pad-identical, so one source publishes both orientations" (at 423.76 314.34 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e58fe0ce-22e5-5d12-bcd2-8a0536c99d83"))
	(group "Review page 01: 1. Camera header" (uuid "8e49da07-8b6e-5786-ad93-08727f03e952") (members "9870f529-44e6-4b20-b7b7-ad6eefe47ea1" "6c98530f-610d-5210-8a80-86b87fca835f" "4b76d8ed-754f-5c11-81f1-6e7305a4407e" "05977f9f-6898-5729-9350-b8d3fb49a931" "9dee20e5-bd6a-5147-9fea-d2e856225218" "d4461b9a-18fe-5d7d-bdf3-08d9ea46c6cc" "8770e0d4-fa0c-5127-a4e9-9d80c52dc23d" "13637765-0614-5379-a61a-192df34e1925" "420bb55e-a2d9-517e-a2ca-09be9fa69fad" "cca9b58f-a35f-5270-950c-c90713e8daee" "4bf34ff9-7cc5-52ef-8c1e-cd67fe0bbf3a" "9b667ba6-2dc8-5653-99d9-3c535d986109" "54ff5249-7636-5114-9d59-d5afcb11fd38" "3aa1a343-951a-56fd-81c6-e48c15f22a37" "dfe53e51-bacc-5e3e-9b58-d81e7591539b" "564348c4-b1d8-54b6-8f90-d2f572a5dcf2" "fff476c9-2d6a-51b6-b090-72fd30fc6a5a" "78580a8c-f2a2-585f-8422-dca6ddbc6fd7" "5e43c73c-ae22-58b9-9457-b7790836a429" "c820cd32-3d24-5216-b6ad-5a33d74664eb"))
