(version 1)

# Floors live in Board Setup, not in this file. For this profile set PCB Editor
# > Board Setup > Constraints > "Minimum clearance" to 0.10 mm and "Minimum
# track width" to 0.10 mm. This file used to carry them as two unconditional
# rules, "JLCPCB rigid FR4 1oz routine track width" and "JLCPCB rigid FR4 1oz
# routine copper clearance". An unconditional custom clearance rule REPLACES
# every netclass clearance instead of flooring it, so while they were present
# every netclass clearance above 0.10 mm resolved to 0.10 mm and DRC could not
# report a clearance violation above it. Do not re-add them as rules; only
# conditional rules compose with netclasses. Removed 2026-09-24, after the same
# fix in the mining project and mouse-joystick-pcb on 2026-09-17. See
# docs/design-block-layout-conventions.md, "Clearance rules".

(rule "JLCPCB rigid FR4 SMD pad-to-pad clearance"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
	(constraint clearance (min 0.15mm)))

(rule "JLCPCB rigid FR4 routine via diameter"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.45mm)))

(rule "JLCPCB rigid FR4 routine via drill"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.20mm)))

(rule "JLCPCB rigid FR4 1oz PTH annular ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.18mm)))

(rule "JLCPCB rigid FR4 via annular ring"
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.125mm)))

(rule "JLCPCB rigid FR4 via hole-to-hole"
	(condition "A.Type == 'Via' && B.Type == 'Via'")
	(constraint hole_to_hole (min 0.20mm)))

(rule "JLCPCB rigid FR4 pad hole-to-hole"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

(rule "JLCPCB rigid FR4 hole to copper"
	(constraint hole_clearance (min 0.20mm)))

(rule "JLCPCB rigid FR4 PTH hole to copper"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.28mm)))

(rule "JLCPCB rigid FR4 routed copper to board edge"
	(constraint edge_clearance (min 0.20mm)))

(rule "JLCPCB rigid FR4 silkscreen clearance"
	(constraint silk_clearance (min 0.15mm)))

(rule "Ignore non-production silkscreen clearance"
	(constraint silk_clearance)
	(severity ignore))

(rule "JLCPCB rigid FR4 silkscreen text height"
	(condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'")
	(constraint text_height (min 1.00mm)))

(rule "JLCPCB rigid FR4 silkscreen text thickness"
	(condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'")
	(constraint text_thickness (min 0.15mm)))
