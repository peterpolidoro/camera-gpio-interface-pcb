	(text "${b5415b67-1b92-49cb-991a-c122d10e2357:REFERENCE}: Output pull-down, unpowered state" (at 326.71 158.164592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1eb0e2a5-4cb1-5f38-ab8c-05a8ce1f93eb"))
