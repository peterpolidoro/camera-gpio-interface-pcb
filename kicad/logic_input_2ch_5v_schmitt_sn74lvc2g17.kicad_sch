	(text "Two-channel Schmitt logic input | 4.7 k / 470 pF filters, SN74LVC2G17, pull-downs and taps" (at 15.24 15.24 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left top)) (uuid "1875eb31-82f5-583b-8fcf-22644a23db6a"))
	(text "Two-channel single-ended logic input conditioner: per-channel series/RC filtering plus an SN74LVC2G17 dual Schmitt-trigger buffer that turns a 3.3 V or 5 V field-wired logic signal into clean 3.3 V logic, with a 100 ohm InstrumentPort tap on each output." (at 15.24 21.082 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "efd77d43-76ca-54c4-b6d7-1050db76a44d"))
	(text "Matching net labels are connected. Group order explains function; PCB placement priorities are stated below." (at 15.24 26.322 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "db755985-834d-58ef-88dd-c3c7a1cd950d"))
	(polyline (pts (xy 15.24 36.482) (xy 109.75 36.482)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "6e6d378c-5b56-59ab-bf76-5de0c8f09477"))
	(text "1. Channel A input filter" (at 15.24 39.022 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "55cb4591-bcbf-5b02-bbc8-82e420e4cc23"))
	(text "${504d6ccc-f8c0-42f9-837f-e30ebb7dd752:REFERENCE} in series with the raw input into ${5e0c81c3-f412-4c13-8485-ec7f1d59d7d1:REFERENCE} to GND forms the 72 kHz low-pass at" (at 15.24 43.172 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0f5e7b35-b5d1-584b-a9bb-c81a61f01cdb"))
	(text "1A; ${99885ad5-2487-4f42-b5fc-c7884fa6dbc3:REFERENCE} holds IN_A_RAW low when nothing is plugged in." (at 15.24 45.712 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ac0b1d63-6307-58f6-b521-7037228ce280"))
	(text "Input series filter resistor, 4.7 k" (at 44.209141 75.946 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3d2d19da-218e-5d43-b8e9-8a5e6da33a6d"))
