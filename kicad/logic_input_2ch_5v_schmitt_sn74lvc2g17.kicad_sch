	(text "PLACE: Series resistors and filter capacitors on the input edge of the block, ${5e0c81c3-f412-4c13-8485-ec7f1d59d7d1:REFERENCE} with" (at 15.24 102.284592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7007d9da-a752-5c0d-8a3f-c2d686ffe603"))
	(text "a short return to GND at the buffer's pin 2 side; keep the raw pair away from motor bridge" (at 15.24 104.824592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e9187e6e-1ff3-578f-ba06-4f3cd63b47fc"))
	(text "outputs with a ground reference beside it." (at 15.24 107.364592 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d39daae6-17ae-5999-8345-5b5673445738"))
