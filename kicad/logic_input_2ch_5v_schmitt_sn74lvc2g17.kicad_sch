	(text "the INSTRUMENT class, the two tap stubs are 0.15 mm." (at 219.5 115.316 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "30db2eec-af1b-5519-9952-1f17ab91250d"))
