	(footprint "orb_weaver_smd:USBLC6-2P6_SOT-666"
		(layer "F.Cu")
		(uuid "69c87e33-5320-43d0-b221-9629f1ba7f64")
		(at 177 106)
		(descr "SOT666 for USBLC6-2P6. Local copy of Package_TO_SOT_SMD:SOT-666 (KiCad 10.0.0 official) that adds jumper_pad_groups for the part's internally bonded I/O pads: 1+6 are I/O1 and 3+4 are I/O2. Without the groups, DRC reports the unrouted pad of each pair as an unconnected item even though the copper is correct. The groups are a property of the USBLC6 die, not of the SOT-666 package, so they must not be added to the generic package footprint - use this part-specific copy instead. Geometry is byte-faithful to upstream, including one duplicated coincident F.Fab line - do not tidy it, or every placed instance reports drc lib_footprint_mismatch until it is updated from the library again.")
		(tags "SOT-666 USBLC6 USBLC6-2P6 ESD jumper_pad_groups")
		(property "Reference" "U403"
			(at 0 -2 0)
