					(thickness 0.15)
				)
			)
		)
		(property "Description" "Two-line plus VBUS ESD protection array for USB 2.0 high speed, 3.5 pF maximum line capacitance, 6 V minimum VBUS breakdown, IEC 61000-4-2 level 4 (15 kV air and contact), SOT-666."
			(at 0 0 270)
			(unlocked yes)
			(layer "F.Fab")
			(hide yes)
			(uuid "db3c09af-e214-42e6-ac3b-05daf05efd08")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
		(property "ow_note" "Forked from KiCad Power_Protection:USBLC6-2P6 to declare jumper_pin_groups 1/6 and 3/4, which are internally connected in the die. Pair it only with orb_weaver_smd:USBLC6-2P6_SOT-666, which carries the matching jumper_pad_groups. The two halves must stay together: with the generic Package_TO_SOT_SMD:SOT-666, DRC reports the unrouted pad of each pair as an unconnected item even when the copper is correct."
			(at 0 0 270)
			(unlocked yes)
			(layer "F.Fab")
			(hide yes)
			(uuid "76bd0650-2c6d-463f-9770-e7066a82dc74")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
